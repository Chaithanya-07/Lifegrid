# Lifegrid configuration template — copy to `.env` and fill in real values.
#
# Placeholders only: this file must never contain real credentials, tokens or connection
# strings pointing at real user data. The API reads this style of configuration from the
# environment (double underscore = section nesting, e.g. `ConnectionStrings__Default` sets
# `ConnectionStrings:Default`); nothing in the app loads a literal `.env` file in local
# development, so treat this as the checklist for deployments (see docs/RAILWAY_DEPLOYMENT.md).
#
# --- API (ASP.NET Core, api/TaskFlow.Api) ----------------------------------------------------------

# SQLite database location. Keep it on a persistent volume in production; the default
# (appsettings.json) is `Data Source=data/taskflow.db`.
ConnectionStrings__Default="Data Source=/data/taskflow.db"

# Data folders — must all live on the same persistent volume as the database.
Backups__Directory="/data/backups"
Attachments__Directory="/data/attachments"

# ASP.NET Data Protection key ring, so session cookies survive restarts/redeploys.
# Required in production; without it every session is invalidated on restart.
DataProtection__KeysDirectory="/data/keys"

# Environment. Production enables Secure cookies and hides OpenAPI.
ASPNETCORE_ENVIRONMENT="Production"

# Hosts the API answers to. The bundled default is localhost-only: until this is set,
# every production request (including the health check) fails with "Invalid Hostname".
AllowedHosts="your-api-domain.example"

# Exact web origin allowed by CORS and the CSRF Origin check (no trailing slash).
Cors__Origins__0="https://your-web-domain.example"

# Enable forwarded-header processing behind a reverse proxy (railway.json / Dockerfile set
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true in the image; see docs/PRODUCTION_SECURITY.md).
ASPNETCORE_FORWARDEDHEADERS_ENABLED="true"

# "Local day" used for today/overdue/analytics/streaks (IANA zone name; default UTC).
TZ="UTC"

# Sign-up controls: close registration or cap the number of accounts.
Auth__AllowRegistration="true"
# Auth__MaxUsers="500"

# Rate limits (requests per minute, per client): auth endpoints and the API generally.
# RateLimit__AuthPerMinute="20"
# RateLimit__ApiPerMinute="600"

# Per-user attachment storage quota in bytes (default 200 MB).
# Limits__MaxUserAttachmentBytes="209715200"

# Railway injects PORT; the entrypoint binds 0.0.0.0:$PORT.
# PORT="8080"

# --- Web (React/Vite, web/) ------------------------------------------------------------------------

# Where the dev server proxies /api requests (default http://localhost:5062).
# Not needed in production builds unless the frontend calls another origin directly.
VITE_API_ORIGIN="http://localhost:5062"
